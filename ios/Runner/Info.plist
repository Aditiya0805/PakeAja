<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Info.plist iOS untuk PakeAja -->
	<!-- Tambahkan key di bawah ke file ios/Runner/Info.plist kamu -->

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PakeAja</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PakeAja</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- ==================== PERMISSION DESKRIPSI ==================== -->

	<!-- Kamera: untuk mengambil foto pakaian -->
	<key>NSCameraUsageDescription</key>
	<string>PakeAja membutuhkan akses kamera untuk mengambil foto pakaian kamu.</string>

	<!-- Galeri: untuk memilih foto dari library -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PakeAja membutuhkan akses galeri untuk memilih foto pakaian kamu.</string>

	<!-- (Opsional) Foto library hanya add-only jika tidak perlu hapus -->
	<!-- <key>NSPhotoLibraryAddUsageDescription</key> -->
	<!-- <string>PakeAja menyimpan foto pakaian ke galeri.</string> -->

	<!-- Apple Music / Library (jangan pakai) -->
	<!-- <key>NSAppleMusicUsageDescription</key> -->

	<!-- ==================== GOOGLE SIGN-IN (jika dipakai) ==================== -->
	<!-- Untuk Google Sign-In di iOS, REVERSED_CLIENT_ID dari GoogleService-Info.plist -->
	<!-- Tambahkan URL scheme di bawah: -->
	<!--
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	-->

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
